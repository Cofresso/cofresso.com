# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://cofresso:cofresso@localhost:5432/cofresso
# Used by integration tests and Playwright
TEST_DATABASE_URL=postgres://cofresso:cofresso@localhost:5432/cofresso_test

SITE_URL=http://localhost:3000

# Coframe SDK slot (leave empty to render nothing)
COFRAME_SITE_KEY=
COFRAME_SCRIPT_URL=

# Coframe Conversion API (server-side conversions and identity mapping)
COFRAME_PROJECT_ID=6a9e31bb82444fc48fd16faf
COFRAME_API_TOKEN=
COFRAME_INGEST_URL=https://ingest.app.coframe.com

# Cloud Run alternative to DATABASE_URL (leave empty locally)
DB_SOCKET_DIR=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Set to "true" to allow `pnpm db:reset` to drop the schema (off by default)
ALLOW_DB_RESET=false

# Kill switch for the deliberate UI interruptions: email capture popup, cookie consent
# banner, chat bubble, social-proof toasts, announcement rotator and deferred sections.
# "off" removes all of them from the page.
UX_INTERRUPTIONS=on

# --- Image generation (scripts/generate-images.ts only; not runtime server env) ---
# Prefer .superpowers/sdd/images/.env, which is git-ignored.
OPENAI_API_KEY=
# export GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token)
GOOGLE_OAUTH_ACCESS_TOKEN=
# The load balancer's backend bucket forwards the full request path, so objects
# are written under an `assets/` prefix inside this bucket even though public
# URLs have no such prefix.
ASSETS_BUCKET=cofresso-prod-assets
